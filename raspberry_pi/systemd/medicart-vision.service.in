[Unit]
Description=MediCart robot program (YOLO safety + Rifat dashboard + driving control -> Arduino Mega)
After=medicart-camera.service network-online.target
Wants=medicart-camera.service

[Service]
Type=simple
User=@USER@
SupplementaryGroups=dialout video
# wait until the splitter is feeding the virtual camera
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/video10 ] && sleep 2 && exit 0; sleep 1; done; exit 0'
# MediCart 3.0 driving control: Firebase login + dashboard settings (root-only file; optional)
EnvironmentFile=-/etc/medicart/control.env
ExecStart=/opt/medicart/vision/run-vision.sh
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
