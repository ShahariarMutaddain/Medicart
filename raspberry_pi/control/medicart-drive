#!/usr/bin/env python3
# ════════════════════════════════════════════════════════════════════════════
#  medicart-drive — drive MediCart from a keyboard on the Pi or over SSH
#
#    ssh medicart@medicart.local      then      medicart-drive
#
#  Talks to the robot program (medicart.py → web_dashboard.py) at http://127.0.0.1:5000,
#  so it uses exactly the same rules as the dashboards, and works with no internet.
#
#    2  MANUAL      1  AUTO (line following)      0 / X  EMERGENCY STOP
#    hold W / ↑ forward   S / ↓ back   A / ← left   D / → right
#    SPACE stop now    + / -  speed    Q quit (wheels stop)
#  One-shot:  medicart-drive auto | manual | stop | status
# ════════════════════════════════════════════════════════════════════════════
import curses
import json
import os
import sys
import time
import urllib.error
import urllib.request

BASE = f"http://127.0.0.1:{os.environ.get('DASHBOARD_PORT', '5000')}"
HOLD_S = 0.6     # a key counts as held this long after its last auto-repeat
SEND_S = 0.1     # the robot's lease is 0.5 s
NAME = f"{os.environ.get('USER', 'pi')} (SSH)"


def api(path, body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(BASE + path, data=data, method="GET" if body is None else "POST",
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=2) as r:
            return json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return {"error": json.loads(e.read()).get("error", str(e)), "status": e.code}
        except ValueError:
            return {"error": str(e), "status": e.code}


def set_mode(mode):
    if mode == "stop":
        return api("/api/stop", {"name": NAME})
    st = api("/api/status")
    return api("/api/mode", {"mode": mode, "stop_token": st.get("stop_token", 0), "name": NAME})


def ui(scr):
    curses.curs_set(0)
    scr.nodelay(True)
    scr.keypad(True)
    curses.use_default_colors()
    for i, c in enumerate((curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED, curses.COLOR_CYAN), 1):
        curses.init_pair(i, c, -1)
    held = {"f": 0.0, "b": 0.0, "l": 0.0, "r": 0.0}
    keymap = {ord("w"): "f", ord("W"): "f", curses.KEY_UP: "f", ord("s"): "b", ord("S"): "b", curses.KEY_DOWN: "b",
              ord("a"): "l", ord("A"): "l", curses.KEY_LEFT: "l", ord("d"): "r", ord("D"): "r", curses.KEY_RIGHT: "r"}
    note = "Press 2 for MANUAL, then hold W/A/S/D or the arrows."
    st, last_send, last_poll, was_moving = {}, 0.0, 0.0, False
    while True:
        now = time.monotonic()
        while True:
            k = scr.getch()
            if k == -1:
                break
            if k in keymap:
                held[keymap[k]] = now
            elif k == ord(" "):
                held = dict.fromkeys(held, 0.0)
            elif k in (ord("+"), ord("=")):
                api("/api/speed", {"speed": min(st.get("max_speed", 180), st.get("speed", 40) + 5)})
            elif k in (ord("-"), ord("_")):
                api("/api/speed", {"speed": max(0, st.get("speed", 40) - 5)})
            elif k == ord("2"):
                r = set_mode("manual")
                note = "MANUAL: hold a direction key." if "error" not in r else f"Refused: {r['error']}"
            elif k == ord("1"):
                r = set_mode("auto")
                note = "AUTO: line following, the camera brakes for people." if "error" not in r else f"Refused: {r['error']}"
            elif k in (ord("0"), ord("x"), ord("X")):
                set_mode("stop")
                held = dict.fromkeys(held, 0.0)
                note = "EMERGENCY STOP. Press 1 (AUTO) or 2 (MANUAL) to release."
            elif k in (ord("q"), ord("Q"), 27):
                api("/api/control", {"forward": 0, "turn": 0, "keys": [], "name": NAME})
                return
        on = {k: (now - t) < HOLD_S for k, t in held.items()}
        fwd = (1 if on["f"] else 0) - (1 if on["b"] else 0)
        turn = (1 if on["r"] else 0) - (1 if on["l"] else 0)
        if fwd and turn:
            turn *= 0.6
        moving = bool(fwd or turn)
        if now - last_send >= SEND_S and st.get("mode") == "manual" and (moving or was_moving):
            last_send = now
            keys = [n for n, v in (("up", on["f"]), ("down", on["b"]), ("left", on["l"]), ("right", on["r"])) if v]
            api("/api/control", {"forward": fwd, "turn": turn, "keys": keys, "name": NAME})
            was_moving = moving
        if now - last_poll >= 0.3:
            last_poll = now
            got = api("/api/status")
            st = got if "error" not in got else st

        scr.erase()
        mode = st.get("mode", "?")
        col = {"auto": 4, "manual": 1, "stopped": 3}.get(mode, 0)
        scr.addstr(0, 0, "MediCart drive", curses.A_BOLD)
        scr.addstr(0, 16, f"  {mode.upper()}  ", curses.color_pair(col) | curses.A_BOLD | curses.A_REVERSE)
        scr.addstr(2, 0, f"Arduino: {st.get('serial', '?'):12} firmware: {st.get('firmware', '?') or '?'}")
        vis = st.get("vision", "?")
        scr.addstr(3, 0, f"Vision : {vis:16}", curses.color_pair(3 if vis in ('STOP', 'PERSON_DETECTED') else 1))
        scr.addstr(3, 26, f"people {st.get('people', 0)}  line {st.get('line', '-----') or '-----'}")
        scr.addstr(5, 0, f"Speed  : {st.get('speed', 0):3} / {st.get('max_speed', 180)}  (+/-)   wheels L {st.get('motor_left', 0):4}  R {st.get('motor_right', 0):4}")
        if st.get("blocked"):
            scr.addstr(6, 0, "Person in the stop zone: not moving", curses.color_pair(3) | curses.A_BOLD)
        scr.addstr(8, 0, "2 MANUAL   1 AUTO   0/X STOP   hold W A S D / arrows   SPACE stop   Q quit")
        scr.addstr(10, 0, note[: max(10, curses.COLS - 1)])
        y = 12
        for ev in (st.get("events") or [])[-5:]:
            if y < curses.LINES - 1:
                t = time.strftime("%H:%M:%S", time.localtime(ev.get("t", 0) / 1000))
                scr.addstr(y, 0, f"{t}  {ev.get('text', '')}"[: max(10, curses.COLS - 1)], curses.A_DIM)
                y += 1
        scr.refresh()
        time.sleep(0.02)


def main():
    try:
        st = api("/api/status")
    except (urllib.error.URLError, OSError):
        print(f"The robot program is not answering at {BASE}. Check:  sudo systemctl status medicart-vision", file=sys.stderr)
        return 1
    if len(sys.argv) > 1:
        cmd = sys.argv[1].lower()
        if cmd == "status":
            print(json.dumps(st, indent=2))
        elif cmd in ("auto", "manual", "stop"):
            print(set_mode(cmd))
        else:
            print(__doc__ or "usage: medicart-drive [auto|manual|stop|status]")
        return 0
    curses.wrapper(ui)
    return 0


if __name__ == "__main__":
    sys.exit(main())
