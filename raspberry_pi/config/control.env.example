# MediCart drive controller — /etc/medicart/control.env  (root only: chmod 600)
# Written by install.sh. Restart after editing:  sudo systemctl restart medicart-control

CART_ID=medicart-01

# Firebase web settings (same as js/config.js — public by design)
FIREBASE_API_KEY=AIzaSyAjDepmO5m_fiWIy_HPcVnN2uHtMwGPv7M
FIREBASE_DB_URL=https://medicart-e20e0-default-rtdb.asia-southeast1.firebasedatabase.app

# The cart account (the same one the cart screen signs in with). Secret: stays on the Pi.
CONTROL_EMAIL=cart01@medicart.iub
CONTROL_PASSWORD=

# Arduino port: auto finds /dev/serial/by-id/*Arduino*, /dev/ttyACM0, /dev/ttyACM1 …
ARDUINO_PORT=auto
# medicart.py gets this virtual port instead of the real one
VISION_TTY=/run/medicart/vision-tty

# Mode after power-on when nothing is saved in Firebase: AUTO, MANUAL or STOP
START_MODE=AUTO
# Manual speed limits (PWM 0-200; the firmware caps at 200)
MANUAL_MAX_PWM=160
# limit used while medicart.py (person detection) is not running
MANUAL_SLOW_PWM=90
# operator dead-man: no fresh command for this long → wheels 0,0
DRIVE_TIMEOUT_S=0.6
