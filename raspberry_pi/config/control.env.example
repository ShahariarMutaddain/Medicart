# MediCart 3.0 driving control — /etc/medicart/control.env  (root only: chmod 600)
# Read by the medicart-vision service (medicart.py). After editing:  sudo systemctl restart medicart-vision

CART_ID=medicart-01

# Firebase (Vercel console Drive page). Web settings are public; the password is secret and stays here.
FIREBASE_API_KEY=AIzaSyAjDepmO5m_fiWIy_HPcVnN2uHtMwGPv7M
FIREBASE_DB_URL=https://medicart-e20e0-default-rtdb.asia-southeast1.firebasedatabase.app
CONTROL_EMAIL=cart01@medicart.iub
CONTROL_PASSWORD=

# Rifat's Pi dashboard (live camera + controls). Without a password it is only reachable on the Pi itself.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_PASSWORD=

# Mode after start-up: stopped (Rifat's default, someone must choose Auto/Manual) or auto
START_MODE=stopped
# Manual driving speed at start-up (PWM 0-180). The line follower runs at 38.
MANUAL_SPEED=40
